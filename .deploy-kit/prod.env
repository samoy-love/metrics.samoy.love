# Цель: стек мониторинга (Prometheus, Grafana, экспортёры).
#
# До появления этого файла мониторинг был единственным, что каталось руками:
# `git pull && docker compose up -d` в /opt/samoylove-metrics. То есть про
# него нельзя было ответить ни «какая версия на проде», ни «что откатывать» —
# ровно те вопросы, ради которых остальное хозяйство переехало на deploy-kit.
# Мониторинг, который сам живёт вне правил, плохо годится в свидетели.
#
# Артефакт — не бинарь и не статика, а описание стека: compose-файл и конфиги
# Prometheus, Grafana, blackbox и экспортёра журналов. Раскладывается так же,
# как всё остальное (releases/<версия> + атомарный симлинк current), а
# применяется перезапуском юнита-обёртки, который поднимает compose из
# current/. Подробности контракта — в deploy/systemd/samoylove-metrics.service.

APP=metrics

# ROOT не /opt/metrics: каталог стека называется по домену и существует с
# первой установки, на него завязаны и .env, и тома docker.
ROOT=/opt/samoylove-metrics

ARTIFACT_DIR=stage
UNIT=samoylove-metrics.service

# Конфиги читают процессы в контейнерах под своими uid (Prometheus — 65534),
# монтируются они только на чтение, поэтому владелец на хосте — root.
OWNER=root:root

# «Сборки» здесь нет: в артефакт уезжает ровно то, что монтируется в
# контейнеры. Перечисление поимённо, а не `cp -r . stage`, — намеренно: так в
# релиз не попадут ни .git, ни README, ни (главное) локальный .env, если он
# у кого-то окажется в рабочем дереве.
BUILD_CMD='rm -rf stage && mkdir -p stage && cp docker-compose.yml stage/ && cp -r prometheus grafana blackbox nginxlog stage/'

# Проверка после переключения — здоровье самого Prometheus, а не код 200 от
# nginx: панель за basic-auth отвечает 401 и живому стеку, и мёртвому.
# /healthz открыт без пароля и проксируется в /-/healthy Prometheus, то есть
# 200 означает «сборщик метрик поднялся с новым конфигом».
HEALTH=https://metrics.samoy.love/healthz

# Nginx общий на все домены, а перезапуск стека задевает вышестоящий прокси
# ошибками 502 — соседей проверяем полным списком.
NEIGHBOURS=samoy.love,metro.samoy.love,launcher.samoy.love,snakes.samoy.love,status.samoy.love

KEEP=5

# version.json раздавать некуда: наружу этот домен отдаёт только Grafana и
# Prometheus, и класть в них свой файл незачем. Выкатка подтверждается именем
# релиза в симлинке current (--no-version-file).
WRITE_VERSION_FILE=0

# Данные ВНЕ каталога релизов и выкатка их не касается:
#   • история Prometheus и настройки Grafana — в именованных томах docker
#     (samoylove-metrics_prometheus-data, samoylove-metrics_grafana-data).
#     Имя проекта прибито в docker-compose.yml (name: samoylove-metrics),
#     поэтому смена каталога релиза на имена томов не влияет: и выкатка, и
#     откат подхватывают ту же историю;
#   • пароль администратора Grafana — /opt/samoylove-metrics/.env, рядом с
#     releases/, но не внутри. В артефакте его нет и быть не должно.

    {
      "type": "stat",
      "title": "CPU",
      "description": "Загрузка всех ядер. Устойчиво выше 80% означает, что соседи начинают мешать друг другу.",
      "targets": [
        {
          "refId": "A",
          "expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"

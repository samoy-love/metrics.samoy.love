    {
      "type": "state-timeline",
      "title": "История проверок",
      "description": "Провал полосы — проверка не проходила, даже если сейчас всё зелёное. Верхняя полоса — blackbox, остальные — агент статус-страницы. Красный blackbox с 12 по 19.09.2026 при зелёном агенте — сломанный маршрут пробы, а не простой сайта.",
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{instance=\"https://die.samoy.love/\"}",
          "legendFormat": "blackbox"

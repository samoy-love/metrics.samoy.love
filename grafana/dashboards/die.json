    {
      "type": "timeseries",
      "title": "Проба снаружи: время по фазам",
      "description": "Из чего складывается ответ главной страницы для blackbox: DNS, TCP, TLS, обработка в nginx, передача тела. Слои сложены, верх графика — полное время. Норма — единицы миллисекунд: проба идёт с того же сервера. Выросла обработка — плохо nginx или диску; вырос TLS — процессору. Тревога ProbeLatencyHigh горит при полном времени больше 3 с.",
      "targets": [
        {
          "refId": "A",
          "expr": "probe_http_duration_seconds{instance=\"https://die.samoy.love/\"}",
          "legendFormat": "{{phase}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []

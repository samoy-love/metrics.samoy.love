    {
      "type": "stat",
      "title": "Доля 4xx за сутки",
      "description": "Ответы 4xx ко всем ответам. Почти всегда это сканеры (/wp-admin, /.env) и старые ссылки, а не поломка. Плохо — рост без сканеров: значит, пропал файл, на который ссылается сама страница; тогда смотреть «Коды ответов» и «Самые запрашиваемые разделы».",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(increase(samoylove_site_http_response_count_total{host=\"die.samoy.love\", status=~\"4..\"}[24h])) or vector(0)) / clamp_min(sum(increase(samoylove_site_http_response_count_total{host=\"die.samoy.love\"}[24h])), 1)",

{
  "uid": "samoylove-die",
  "title": "Double or Die — игра",
  "description": "Кооп-рогалик со ставками на себя. Пока чистая статика: весь геймплей считается в браузере, поэтому серверных метрик нет и не должно быть — телеметрия появится в 0.11.0.",
  "tags": [
    "samoy.love",
    "проект"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Проекты",
      "tags": [
        "samoy.love"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Доступность",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Игра",
      "description": "Прод: то, во что играют.",
      "targets": [
        {
          "refId": "A",
          "expr": "status_check_up{check=\"die\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "samoylove-prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Манифест версии",
      "description": "По нему игрок узнаёт о новой сборке. Сломается — игроки останутся на старой версии молча.",
      "targets": [
        {
          "refId": "A",
          "expr": "status_check_up{check=\"die-version\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "samoylove-prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Service worker",
      "description": "Отвечает за офлайн и подхват обновления.",
      "targets": [
        {
          "refId": "A",
          "expr": "status_check_up{check=\"die-sw\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "samoylove-prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Сертификат",
      "description": "Дней до истечения. Продление автоматическое, поэтому число, ползущее к нулю, означает, что автопродление сломалось.",
      "targets": [
        {
          "refId": "A",
          "expr": "status_cert_days_left{check=\"die\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 7
              },
              {
                "color": "green",
                "value": 21
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "samoylove-prometheus"
      }
    },
    {
      "type": "row",
      "title": "Игра",
      "id": 7,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": [],
      "description": "Статика, считающаяся целиком в браузере: бэкенда у игры пока нет."
    },
    {
      "type": "stat",
      "title": "Посетители за сутки",
      "description": "Обращения к главной странице: грубая, но честная оценка посещаемости. Заходы на внутренние адреса и ассеты сюда не попадают.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(samoylove_site_http_response_count_total{host=\"die.samoy.love\", path=\"/\"}[24h]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 8,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "samoylove-prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Отдано за сутки",
      "description": "Сколько байт ушло посетителям. Резкий рост без роста посещаемости — обычно случайно попавший в раздачу тяжёлый файл.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(samoylove_site_http_response_size_bytes{host=\"die.samoy.love\"}[24h]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 9,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "samoylove-prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Доля ошибок за сутки",
      "description": "Ответы 4xx и 5xx ко всем ответам. 4xx — чаще всего сканеры и старые ссылки, 5xx — всегда наша вина.",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(increase(samoylove_site_http_response_count_total{host=\"die.samoy.love\", status=~\"[45]..\"}[24h])) or vector(0)) / clamp_min(sum(increase(samoylove_site_http_response_count_total{host=\"die.samoy.love\"}[24h])), 1)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 10,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "samoylove-prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Время ответа, p95",
      "description": "Отдача статики с того же сервера. Десятки миллисекунд — норма, сотни означают, что диску или сети плохо.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(samoylove_site_http_response_time_seconds_hist_bucket{host=\"die.samoy.love\"}[1h])) by (le))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 11,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "samoylove-prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Запросы по разделам",
      "description": "Куда именно ходят. Разделение по пути показывает, чем пользуются, а не только сколько заходов.",
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum(rate(samoylove_site_http_response_count_total{host=\"die.samoy.love\"}[10m])) by (path)",
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "samoylove-prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Коды ответов",
      "description": "Всплеск 4xx обычно означает сканера или битую ссылку, любой 5xx — дефект на нашей стороне.",
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum(rate(samoylove_site_http_response_count_total{host=\"die.samoy.love\"}[10m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "samoylove-prometheus"
      }
    }
  ]
}

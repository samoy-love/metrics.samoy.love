     "expr": "histogram_quantile(0.50, sum by (le, parser) (rate(cs2_parse_duration_seconds_bucket[15m])))",
     "legendFormat": "{{parser}} p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le, parser) (rate(cs2_parse_duration_seconds_bucket[15m])))",
     "legendFormat": "{{parser}} p95"

                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "samoylove-prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Разбор, 95-я доля",
      "description": "Девяносто пять разборов из ста укладываются в это время. Среднее здесь врёт: одна битая демка тянет его вверх на порядок.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cs2_parse_duration_seconds_bucket[24h])))",

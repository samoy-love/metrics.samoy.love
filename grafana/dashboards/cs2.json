      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "samoylove-prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Доля отказов за сутки",
      "description": "Отказы к общему числу. Знаменатель — ВСЕ разборы, а не только неудачные: иначе метрика показывала бы сто процентов всегда.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(cs2_parse_total{result!=\"ok\"}[24h])) / clamp_min(sum(increase(cs2_parse_total[24h])), 1) * 100",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",

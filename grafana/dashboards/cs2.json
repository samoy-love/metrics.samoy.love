  "description": "Разбор матчей CS2: очередь, исходы, время разбора, хранилище демок и люди. Все числа считаются поверх сырых событий — предпосчитанных агрегатов в хранилище нет.",
  "editable": true,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Разбор демок",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "description": "Очередь, исходы и время. Разбор идёт секунды: всё, что дольше минуты, — повод смотреть."
    },
    {
      "type": "stat",
      "title": "В очереди",
      "description": "Заданий ждёт разбора прямо сейчас. Устойчивый рост означает, что воркеры не успевают.",
      "targets": [
        {
          "refId": "A",
          "expr": "cs2_parse_queue_depth",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "samoylove-prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Разборов за сутки",
      "description": "Сколько демок разобрано, включая неудачные.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(cs2_parse_total[24h]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"

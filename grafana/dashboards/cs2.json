        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, parser) (rate(cs2_parse_duration_seconds_bucket[1h])))",
          "legendFormat": "p50 {{parser}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, parser) (rate(cs2_parse_duration_seconds_bucket[1h])))",
          "legendFormat": "p95 {{parser}}"
        }
      ],

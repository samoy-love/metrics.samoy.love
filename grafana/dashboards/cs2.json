    {
      "type": "timeseries",
      "title": "Исходы разбора",
      "description": "Успешные и неудачные разборы в час. Всплеск отказов после выкатки — первый признак, что сломался парсер, а не демка.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(cs2_parse_total[1h]) * 3600)",
          "legendFormat": "{{result}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "decimals": 1,
          "min": 0
        },
        "overrides": []

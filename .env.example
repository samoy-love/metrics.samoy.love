# Образец. На сервере копируется в /opt/samoylove-metrics/.env и заполняется
# настоящим значением; сам .env в репозиторий не попадает (см. .gitignore).
#
#   cp .env.example .env
#   sed -i "s/ЗАМЕНИТЬ/$(openssl rand -base64 24)/" .env
#   chmod 600 .env

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ЗАМЕНИТЬ
